# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Only the HOSTED deployment (case 3) needs anything here.

# --- hosted mode (case 3) --------------------------------------------------
# The server's own Anthropic API key. It pays for the model so public visitors
# need no AI tools of their own. REQUIRED for `docker compose up`.
QOPT_API_KEY=sk-ant-...

# Optional model override (default: claude-sonnet-4-6).
# QOPT_API_MODEL=claude-sonnet-4-6

# --- advanced: standalone server (not needed by the launchers/compose) -----
# The database connection string. A SERVER SECRET — never sent by the browser.
# Use a READ-ONLY account; the safety guard refuses non-SELECT regardless.
# sqlite: a file path.  mysql: user:pass@tcp(host:3306)/db
# QOPT_DSN=root:root@tcp(127.0.0.1:3306)/demo

# QOPT_MODE=local        # local | hosted | verify
# QOPT_ENGINE=sqlite     # sqlite | mysql
# QOPT_ADDR=:8080
# QOPT_CORS_ORIGIN=*
# QOPT_TIMEOUT=60
